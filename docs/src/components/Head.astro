---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 OpenFray contributors

// SEO additions on top of Starlight's default <head>. Starlight already emits the
// title, canonical link, description, and the base OpenGraph/Twitter tags; this adds
// what it leaves out: og:image, the rest of the Twitter card, a keywords meta, a
// theme-color, and JSON-LD structured data. Rendered as raw elements (not merged into
// Starlight's head array), so it must not repeat tags Starlight already emits.
import Default from '@astrojs/starlight/components/Head.astro';

const { entry } = Astro.locals.starlightRoute;
const { title, description, template } = entry.data;
const pageKeywords = entry.data.keywords ?? [];

const site = Astro.site ?? new URL('https://openfray.app');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;
const desc =
  description ??
  'OpenFray is a free, browser-based Dungeons and Dragons 5e combat console and initiative tracker for Game Masters.';

// The overview page uses Starlight's splash template; everything else is a doc page.
const isHome = template === 'splash';

// Site-wide search terms, in the words readers actually type. Per-page `keywords`
// frontmatter is layered on top.
// House forms only — no "D&D"/"Dungeons & Dragons" ampersand marks (those are WotC's,
// used only for the "D&D Beyond" product name and in legal statements).
const baseKeywords = [
  'Dungeons and Dragons',
  'Dungeons and Dragons 5e',
  'DnD 5e',
  '5th edition',
  '5e',
  'DnD 2024',
  '5.5 edition',
  'initiative tracker',
  'DnD initiative tracker',
  'Dungeons and Dragons initiative tracker',
  'combat tracker',
  'Dungeons and Dragons combat tracker',
  'DnD encounter tracker',
  'Game Master tools',
  'tabletop RPG',
  'TTRPG',
  'OpenFray',
];
const keywords = [...new Set([...pageKeywords, ...baseKeywords])].join(', ');

/** @type {Record<string, unknown>[]} */
const graph = [
  {
    '@type': 'WebSite',
    '@id': 'https://openfray.app/#website',
    name: 'OpenFray',
    url: 'https://openfray.app/',
    description:
      'A free, browser-based Dungeons and Dragons 5e (5th edition) combat console and initiative tracker for Game Masters.',
    inLanguage: 'en',
  },
];

if (isHome) {
  graph.push({
    '@type': 'SoftwareApplication',
    '@id': 'https://openfray.app/#app',
    name: 'OpenFray',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web browser',
    url: 'https://openfray.app/console/',
    description:
      'A free, open-source Dungeons and Dragons 5e combat console and initiative tracker for Game Masters — initiative order, conditions and effects, monster resources, group saves, and honest dice.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
  });
} else {
  graph.push({
    '@type': 'TechArticle',
    '@id': `${canonical}#article`,
    headline: title,
    description: desc,
    url: canonical,
    inLanguage: 'en',
    isPartOf: { '@id': 'https://openfray.app/#website' },
    about: [
      { '@type': 'Thing', name: 'Dungeons and Dragons 5e' },
      { '@type': 'Thing', name: 'Tabletop role-playing games' },
    ],
  });
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'OpenFray documentation',
        item: 'https://openfray.app/docs/',
      },
      { '@type': 'ListItem', position: 2, name: title, item: canonical },
    ],
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<Default><slot /></Default>

<meta name="keywords" content={keywords} />
<meta name="theme-color" content="#020617" />

{/* og:image and the rest of the Twitter card — Starlight emits neither. */}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="OpenFray — a Dungeons and Dragons 5e combat console for Game Masters"
/>
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
